# Connexion PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/cap_pfmp
# Dossier où sont stockés les fichiers déposés (à remplacer par un stockage objet en production)
UPLOAD_DIR=./uploads
# Mettre "true" en production (HTTPS) pour des cookies sécurisés
COOKIE_SECURE=false
# Jeton secret (24 caractères minimum) pour la tâche quotidienne des relances : /api/taches/quotidiennes
TACHES_JETON=
# Double authentification obligatoire pour la direction et la gestion (true par défaut). "false" seulement pour une démonstration.
DOUBLE_AUTH_OBLIGATOIRE=true
# Agents IA (Cap Admin, Cap Veille, Cap Partenaires). Sans clé : textes d'exemple, sans appel à l'IA.
ANTHROPIC_API_KEY=
# Cap Veille : accès à l'API Légifrance (piste.gouv.fr). Cap Partenaires : La bonne boîte (francetravail.io).
LEGIFRANCE_ID=
LEGIFRANCE_SECRET=
FRANCE_TRAVAIL_ID=
FRANCE_TRAVAIL_SECRET=

# Cap Partenaires, entraînement à l'entretien à l'oral (option payante du lycée) : service de reconnaissance vocale
# hébergé en Europe, qui reçoit le son et répond { "texte": "…" }. Sans lui, l'entraînement se fait par écrit.
CAP_PFMP_VOIX_URL=
CAP_PFMP_VOIX_CLE=
